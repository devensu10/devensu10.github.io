---
import type { MarkdownHeading } from "astro";
import { useTranslations } from "@/i18n";

type Props = {
  headings: MarkdownHeading[];
  class?: string;
};

const { headings, class: className = "" } = Astro.props;

const t = useTranslations(Astro.currentLocale);

type TocItem = MarkdownHeading & { children: TocItem[] };

const items: TocItem[] = [];
for (const heading of headings) {
  const item: TocItem = { ...heading, children: [] };
  if (heading.depth === 3 && items.length > 0) {
    items[items.length - 1].children.push(item);
  } else {
    items.push(item);
  }
}
---

<nav aria-label={t.post.tableOfContents} class={className}>
  <ul class="space-y-2">
    {
      items.map(item => (
        <li>
          <a href={`#${item.slug}`} data-toc-link={item.slug} class="toc-link">
            {item.text}
          </a>
          {item.children.length > 0 && (
            <ul class="mt-2 space-y-2">
              {item.children.map(child => (
                <li>
                  <a
                    href={`#${child.slug}`}
                    data-toc-link={child.slug}
                    class="toc-link ms-4"
                  >
                    {child.text}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<script is:inline data-astro-rerun>
  function initTocHighlight() {
    window.__tocObserver?.disconnect();

    const links = Array.from(document.querySelectorAll("[data-toc-link]"));
    if (links.length === 0) return;

    const article = document.getElementById("article");
    if (!article) return;

    const setActive = slug => {
      for (const link of links) {
        link.classList.toggle(
          "toc-link-active",
          link.getAttribute("data-toc-link") === slug
        );
      }
    };

    const headings = Array.from(article.querySelectorAll("h2[id], h3[id]"));
    const observer = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: "0px 0px -70% 0px" }
    );
    for (const heading of headings) observer.observe(heading);

    window.__tocObserver = observer;
  }
  initTocHighlight();
</script>
